# ====================================================
# LabInsight AI — Backend Environment Configuration
# ====================================================
# Copy this file to .env and customize secrets.
# NEVER commit the actual .env file.
# ====================================================

APP_ENV=development
APP_NAME="LabInsight AI"
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# Security (Change in production!)
SECRET_KEY=dev_insecure_secret_key_generate_with_openssl_rand_hex_64_for_production
SESSION_COOKIE_NAME=labinsight_session
SESSION_MAX_AGE_SECONDS=3600
CSRF_TOKEN_HEADER=X-CSRF-Token

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=labinsight_db
POSTGRES_USER=labinsight_app
POSTGRES_PASSWORD=labinsight_dev_secret_pw_123
DATABASE_URL=postgresql+psycopg://labinsight_app:labinsight_dev_secret_pw_123@postgres:5432/labinsight_db

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_SESSION_DB=0
REDIS_RATELIMIT_DB=1

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_RESET_PER_MINUTE=3
RATE_LIMIT_GENERAL_PER_MINUTE=120

# MFA
MFA_ISSUER_NAME="LabInsight AI"

# File Upload & Reports
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=/app/uploads
REPORTS_DIR=/app/generated_reports
REPORT_RETENTION_DAYS=30

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=labinsight_default

# Frontend URL
FRONTEND_URL=http://localhost:5173
